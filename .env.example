ALPHA_BOT_TOKEN=

ALPHA_SPACE_ID=magistrigusti/allod-alpha

# Primary NVIDIA API key
ALPHA_API_KEY=
# Optional separate API key for fallback models; uses primary when empty
ALPHA_MODEL_FALLBACKS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_FALLBACKS=z-ai/glm-5.3-flash
# Optional local port for Express
PORT=3000

# Telegram runtime: use polling locally and webhook on Render
ALPHA_TELEGRAM_MODE=polling
# Render provides RENDER_EXTERNAL_URL automatically. For another host:
# ALPHA_PUBLIC_URL=https://your-alpha-service.example
# ALPHA_TELEGRAM_WEBHOOK_PATH=/api/telegram

# Optional: how many messages Alpha keeps per chat in Telegram
ALPHA_CHAT_HISTORY_LIMIT=24

# Optional: per Alpha request settings
ALPHA_REQUEST_TIMEOUT_MS=25000
ALPHA_MAX_CONTEXT_MESSAGES=8
ALPHA_MAX_TOKENS=420
ALPHA_TEMPERATURE=0.35
ALPHA_TOP_P=0.9

# Optional: browser origins allowed to call /api/alpha
ALPHA_CORS_ORIGIN=*

# Optional Telegram webhook security
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Legacy manual webhook setup endpoint
TELEGRAM_WEBHOOK_SETUP_TOKEN=replace-with-random-secret
